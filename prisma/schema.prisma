datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum OrderStatus {
  AWAITING_PAYMENT
  IN_PROGRESS
  SHIPPED_AWAITING_PAYMENT
  CANCELLED
  DONE
}

enum OrderDocumentCategory {
  INVOICE
  UPD
  WAYBILL
}

enum DeliveryMethod {
  ADDRESS
  TERMINAL
  PICKUP
}

enum PaymentStatus {
  PENDING
  WAITING_FOR_CAPTURE
  SUCCEEDED
  CANCELED
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Product {
  id           String      @id @default(cuid())
  sku          String      @unique
  name         String
  slug         String      @unique
  description  String?
  price        Int
  stock        Int         @default(0)
  images       String[]
  categoryId   String
  category     Category    @relation(fields: [categoryId], references: [id])
  brand        String?
  attributes   Json?
  isActive     Boolean     @default(true)
  orderItems   OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  // Bumped to now() on creation and whenever stock increases -- drives the
  // "Новое поступление" section independently of createdAt/updatedAt.
  newArrivalAt DateTime    @default(now())

  searchLogs SearchLog[]
  pricing    ProductPricing?

  // Cards in 1С:Бухгалтерия this product stands for (1С often holds the same
  // article on several cards).
  oneCLinks   OneCProductLink[]
  // Confirmed in «Сопоставление с 1С»: there is no such card in 1С yet.
  oneCNoMatch Boolean           @default(false)

  @@index([categoryId])
  @@index([isActive])
  @@index([newArrivalAt])
}

// One 1С card (Catalog_Номенклатура Ref_Key) -> the site product it is. The
// first link is the card new documents for the product are written with.
model OneCProductLink {
  ref       String   @id
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId])
}

// Internal prices live apart from Product on purpose: storefront pages pass
// whole Product rows to client components, so anything on Product ends up in
// every visitor's page source. Product.price is the wholesale price -- the
// one shown on the site.
model ProductPricing {
  productId     String   @id
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchasePrice Int
  retailPrice   Int
  dealerPrice   Int
  supplierId    String?
  supplier      Company? @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
}

// Singleton (id is always 1): default markups over the purchase price,
// in percent, applied to new and imported products.
model PriceSettings {
  id              Int   @id @default(1)
  retailMarkup    Float @default(30)
  wholesaleMarkup Float @default(20)
  dealerMarkup    Float @default(15)
}

model Order {
  id                 String          @id @default(cuid())
  orderNumber        String          @unique
  customerName       String
  customerPhone      String
  customerEmail      String?
  deliveryNote       String?
  status             OrderStatus     @default(AWAITING_PAYMENT)
  paid               Boolean         @default(false)
  deliveryDate       DateTime?
  // Set once, automatically, the first time the order enters
  // SHIPPED_AWAITING_PAYMENT -- distinct from deliveryDate, which staff set
  // by hand as a planned delivery date.
  shippedAt          DateTime?
  // shippedAt + the customer's company paymentDeferralDays, computed at the
  // same moment shippedAt is set, only when that company's paymentType is
  // DEFERRED. Null for prepayment/no-company orders (plain paid/unpaid).
  plannedPaymentDate DateTime?
  totalAmount        Int
  userId             String?
  user               User?           @relation(fields: [userId], references: [id])
  items              OrderItem[]
  documents          OrderDocument[]
  payment            Payment?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([status])
  @@index([userId])
}

model OrderDocument {
  id         String                @id @default(cuid())
  orderId    String
  order      Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  category   OrderDocumentCategory
  fileName   String
  fileUrl    String
  uploadedAt DateTime              @default(now())

  @@index([orderId, category])
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product @relation(fields: [productId], references: [id])
  nameSnapshot  String
  priceSnapshot Int
  quantity      Int
  cancelled     Boolean @default(false)

  @@index([orderId])
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String        @unique
  order           Order         @relation(fields: [orderId], references: [id])
  yookassaId      String        @unique
  status          PaymentStatus @default(PENDING)
  confirmationUrl String?
  rawPayload      Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  SENIOR_MANAGER
  CHIEF_MANAGER
  SUPPLIER
  MECHANIC
  DISPATCHER
  ACCOUNTANT
  CUSTOMER
  DRIVER
}

model User {
  id                    String          @id @default(cuid())
  lastName              String?
  firstName             String?
  patronymic            String?
  login                 String          @unique
  passwordHash          String
  email                 String?         @unique
  phone                 String?
  role                  Role
  companyId             String?
  company               Company?        @relation("CompanyUsers", fields: [companyId], references: [id])
  managedCompanies      Company[]       @relation("CompanyManager")
  orders                Order[]
  // Saved from the customer's own "Настройки" card and pre-filled into new
  // checkouts -- independent of the checkout page's own localStorage memory.
  defaultDeliveryMethod DeliveryMethod?
  defaultSettlement     String?
  defaultStreet         String?
  defaultHouse          String?
  defaultApartment      String?
  defaultTerminal       String?
  // Personal mailbox for staff correspondence -- server/ports come from the
  // site's MailSettings, only the credentials are per user. Never set for
  // CUSTOMER accounts.
  mailLogin             String?
  mailPasswordEnc       String?
  // Own preferences from Почта → Настройки.
  mailSenderName        String?
  mailSignature         String?
  // Image appended to the signature, sent as an inline (cid) attachment.
  mailSignatureLogo     Bytes?
  mailSignatureLogoType String?
  mailPageSize          Int             @default(30)
  // E-mail confirmation for self-registered customers. Null = not yet
  // confirmed. The 6-digit code is stored only as a sha256 hash.
  emailVerifiedAt       DateTime?
  emailCodeHash         String?
  emailCodeExpiresAt    DateTime?
  emailCodeSentAt       DateTime?
  emailCodeAttempts     Int             @default(0)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([role])
  @@index([companyId])
}

// Singleton (id is always 1): the site's own mailbox, used to send
// informational emails, plus the server settings every user mailbox reuses.
model MailSettings {
  id          Int      @id @default(1)
  smtpHost    String
  smtpPort    Int
  imapHost    String
  imapPort    Int
  login       String
  passwordEnc String
  senderEmail String
  senderName  String?
  updatedAt   DateTime @updatedAt
}

// Singleton (id is always 1): 1С:Бухгалтерия (1С:Фреш) reached over the
// standard OData interface with a dedicated integration user.
model OneCSettings {
  id          Int      @id @default(1)
  baseUrl     String
  login       String
  passwordEnc String
  updatedAt   DateTime @updatedAt
}

// Singleton (id is always 1): Яндекс.Флот (Яндекс Про) park connection for
// the Fleet API (fleet-api.taxi.yandex.net).
model YandexFleetSettings {
  id        Int      @id @default(1)
  parkId    String
  clientId  String
  apiKeyEnc String
  updatedAt DateTime @updatedAt
}

// Singleton (id is always 1): GlonassSoft monitoring account whose map is
// shown in Таксопарк → Диспетчерская.
model GlonassSettings {
  id          Int      @id @default(1)
  serverUrl   String
  login       String
  passwordEnc String
  updatedAt   DateTime @updatedAt
}

model Company {
  id                  String             @id @default(cuid())
  name                String
  inn                 String?
  ogrn                String?
  address             String?
  contract            String?
  type                String?
  users               User[]             @relation("CompanyUsers")
  managerId           String?
  manager             User?              @relation("CompanyManager", fields: [managerId], references: [id])
  // "Договор" checkbox -- the contract number field is only editable while
  // this is checked.
  hasContract         Boolean            @default(false)
  paymentType         CompanyPaymentType @default(PREPAYMENT)
  // Only meaningful when paymentType is DEFERRED.
  paymentDeferralDays Int?
  documents           CompanyDocument[]
  suppliedProducts    ProductPricing[]
  kpp                 String?
  // Link to 1С:Бухгалтерия (Catalog_Контрагенты Ref_Key).
  oneCRef             String?            @unique
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([managerId])
}

model CompanyDocument {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fileName   String
  fileUrl    String
  uploadedAt DateTime @default(now())

  @@index([companyId])
}

enum CompanyPaymentType {
  PREPAYMENT
  DEFERRED
}

enum DriverApplicationStatus {
  NEW
  CONTACTED
}

enum VehicleStatus {
  FREE
  IN_WORK
  IN_REPAIR
  IN_RENT
  DECOMMISSIONED
}

model Vehicle {
  id           String            @id @default(cuid())
  brand        String
  model        String
  licensePlate String            @unique
  vin          String            @unique
  color        String
  year         Int
  ptsNumber    String
  ptsIssueDate DateTime
  stsNumber    String
  stsIssueDate DateTime
  // Status transition logic isn't defined yet -- every vehicle is created as
  // FREE for now.
  status       VehicleStatus     @default(FREE)
  documents    VehicleDocument[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status])
}

model VehicleDocument {
  id         String   @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  fileName   String
  fileUrl    String
  uploadedAt DateTime @default(now())

  @@index([vehicleId])
}

model DriverApplication {
  id                       String                  @id @default(cuid())
  name                     String
  phone                    String
  drivingExperienceYears   Int?
  previousDriverExperience Boolean
  status                   DriverApplicationStatus @default(NEW)
  createdAt                DateTime                @default(now())

  @@index([status])
}

model SearchLog {
  id          String           @id @default(cuid())
  productId   String?
  product     Product?         @relation(fields: [productId], references: [id])
  brand       String
  sku         String
  name        String?
  inSystem    Boolean
  totalCount  Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  dailyCounts SearchLogDaily[]

  @@unique([brand, sku])
  @@index([productId])
  @@index([inSystem])
}

model SearchLogDaily {
  id          String    @id @default(cuid())
  searchLogId String
  searchLog   SearchLog @relation(fields: [searchLogId], references: [id], onDelete: Cascade)
  date        DateTime
  count       Int       @default(0)

  @@unique([searchLogId, date])
  @@index([searchLogId])
}

// Short-lived handoff between the bulk-search upload action and the results
// page -- stores only the raw input rows so stock is always re-resolved live
// against the current product table rather than a stale snapshot.
model BulkSearchRequest {
  id        String   @id @default(cuid())
  rows      Json
  createdAt DateTime @default(now())
}
