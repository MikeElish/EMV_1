generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  isActive  Boolean    @default(true)
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
}

model Product {
  id                  String              @id @default(cuid())
  sku                 String              @unique
  name                String
  slug                String              @unique
  description         String?
  price               Int
  stock               Int                 @default(0)
  images              String[]
  categoryId          String
  brand               String?
  attributes          Json?
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  newArrivalAt        DateTime            @default(now())
  oneCNoMatch         Boolean             @default(false)
  pendingRegistration Boolean             @default(false)
  extraCostLines      ExtraCostLine[]
  oneCLinks           OneCProductLink[]
  orderItems          OrderItem[]
  category            Category            @relation(fields: [categoryId], references: [id])
  pricing             ProductPricing?
  repairLines         RepairLine[]
  searchLogs          SearchLog[]
  offers              SupplierOffer[]
  partnerStocks       PartnerStock[]
  priceRequestLines   PriceRequestLine[]
  supplierOrderLines  SupplierOrderLine[]

  @@index([categoryId])
  @@index([isActive])
  @@index([newArrivalAt])
}

model OneCIgnoredGood {
  ref       String   @id
  name      String
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  source         String
  consentAt      DateTime  @default(now())
  consentIp      String?
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  token          String    @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model NewsletterInvite {
  email     String    @id
  name      String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())
}

model StoragePlace {
  warehouseRef String
  itemRef      String
  place        String
  updatedAt    DateTime @updatedAt

  @@id([warehouseRef, itemRef])
}

model OneCProductLink {
  ref       String   @id
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductPricing {
  productId     String   @id
  purchasePrice Int
  retailPrice   Int
  dealerPrice   Int
  supplierId    String?
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier      Company? @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
}

model SupplierOffer {
  id                     String              @id @default(cuid())
  productId              String
  supplierId             String?
  /// RUB equivalent including the configured markup for foreign-currency offers.
  price                  Int
  /// Supplier's quoted amount in `currency`.
  quotedPrice            Int?
  currency               String              @default("RUB")
  exchangeRate           Float?              @default(1)
  logisticsMarkupPercent Float               @default(0)
  deliveryDays           Int?
  quality                String?
  warehouse              String?
  selected               Boolean             @default(false)
  noOffer                Boolean             @default(false)
  inStock                Boolean             @default(false)
  stockQuantity          Int?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  fileName               String?
  fileUrl                String?
  priceUpdatedAt         DateTime            @default(now())
  orderItems             OrderItem[]
  product                Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier               Company?            @relation(fields: [supplierId], references: [id])
  supplierOrderLines     SupplierOrderLine[]
  partnerStocks          PartnerStock[]

  @@index([productId])
  @@index([supplierId])
}

model PartnerStock {
  id          String        @id @default(cuid())
  supplierId  String
  productId   String?
  offerId     String?
  brand       String?
  name        String?
  sku         String?
  quantity    Int?
  price       Int?
  total       Int?
  source      String        @default("MANUAL")
  updatedAt   DateTime      @updatedAt
  createdAt   DateTime      @default(now())
  supplier    Company       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product     Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  offer       SupplierOffer? @relation(fields: [offerId], references: [id], onDelete: SetNull)

  @@unique([supplierId, sku])
  @@index([supplierId])
  @@index([productId])
  @@index([offerId])
}

model SupplierOrderLine {
  id                     String              @id @default(cuid())
  productId              String
  supplierId             String?
  offerId                String?
  /// RUB equivalent; for foreign-currency lines this includes the configured markup.
  price                  Int
  /// Amount payable to the supplier in `currency`.
  quotedPrice            Int?
  currency               String              @default("RUB")
  exchangeRate           Float?              @default(1)
  logisticsMarkupPercent Float               @default(0)
  quantity               Int
  deliveryDays           Int?
  quality                String?
  warehouse              String?
  buyerOrderNumber       String?
  forStock               Boolean             @default(false)
  orderItemId            String?
  createdAt              DateTime            @default(now())
  status                 SupplierOrderStatus @default(TO_CHECK)
  purchaseId             String?
  receiptId              String?
  noOffer                Boolean             @default(false)
  offer                  SupplierOffer?      @relation(fields: [offerId], references: [id])
  orderItem              OrderItem?          @relation(fields: [orderItemId], references: [id])
  product                Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchase               SupplierPurchase?   @relation(fields: [purchaseId], references: [id])
  receipt                SupplierReceipt?    @relation(fields: [receiptId], references: [id])
  supplier               Company?            @relation(fields: [supplierId], references: [id])

  @@index([productId])
  @@index([orderItemId])
}

model PriceSettings {
  id              Int   @id @default(1)
  retailMarkup    Float @default(30)
  wholesaleMarkup Float @default(20)
  dealerMarkup    Float @default(15)
  exchangeRateUsd Float @default(0)
  exchangeRateEur Float @default(0)
  exchangeRateCny Float @default(0)
}

model Order {
  id                 String             @id @default(cuid())
  orderNumber        String             @unique
  customerName       String
  customerPhone      String
  customerEmail      String?
  deliveryNote       String?
  status             OrderStatus        @default(AWAITING_PAYMENT)
  totalAmount        Int
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deliveryDate       DateTime?
  paid               Boolean            @default(false)
  userId             String?
  shippedAt          DateTime?
  plannedPaymentDate DateTime?
  deferred           Boolean            @default(false)
  invoiceRef         String?
  invoiceNumber      String?
  invoiceDate        DateTime?
  handover           String?
  handoverAt         DateTime?
  handoverNote       String?
  termsAcceptedAt    DateTime?
  managerId          String?
  buyerCompanyId     String?
  bankTransactions   BankTransaction[]
  cashReceipts       CashReceipt[]
  claims             Claim[]
  extraCosts         ExtraCost[]
  buyerCompany       Company?           @relation("OrderBuyerCompany", fields: [buyerCompanyId], references: [id])
  manager            User?              @relation("OrderManager", fields: [managerId], references: [id])
  user               User?              @relation(fields: [userId], references: [id])
  documents          OrderDocument[]
  items              OrderItem[]
  payments           Payment[]
  paymentRequests    PaymentRequest[]
  priceRequests      PriceRequest[]
  supplierPurchases  SupplierPurchase[]

  @@index([status])
  @@index([userId])
  @@index([buyerCompanyId])
}

model Service {
  id             String          @id @default(cuid())
  name           String
  code           String?         @unique
  unit           String?
  price          Int             @default(0)
  description    String?
  isActive       Boolean         @default(true)
  oneCRef        String?         @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  extraCosts     ExtraCost[]
  extraCostLines ExtraCostLine[]
  repairLines    RepairLine[]
}

model ExtraCost {
  id             String          @id @default(cuid())
  number         String          @default("")
  date           DateTime        @default(now())
  orderId        String?
  serviceId      String?
  amount         Int
  note           String?
  createdAt      DateTime        @default(now())
  fileName       String?
  fileUrl        String?
  kind           String          @default("Иные затраты")
  status         String          @default("Требуется оплата")
  supplierId     String?
  employeeId     String?
  employee       User?           @relation("ExtraCostEmployee", fields: [employeeId], references: [id])
  order          Order?          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service        Service?        @relation(fields: [serviceId], references: [id])
  supplier       Company?        @relation("ExtraCostSupplier", fields: [supplierId], references: [id])
  lines          ExtraCostLine[]
  paymentRequest PaymentRequest?

  @@index([orderId])
  @@index([supplierId])
  @@index([employeeId])
}

/// *
///  * Табличная часть of a cost: «Товары» (catalogue products) or «Услуги» (services of 1С).
model ExtraCostLine {
  id          String    @id @default(cuid())
  extraCostId String
  kind        String
  productId   String?
  serviceId   String?
  name        String
  quantity    Float
  price       Int
  sum         Int
  extraCost   ExtraCost @relation(fields: [extraCostId], references: [id], onDelete: Cascade)
  product     Product?  @relation(fields: [productId], references: [id])
  service     Service?  @relation(fields: [serviceId], references: [id])

  @@index([extraCostId])
}

model OrderDocument {
  id         String                @id @default(cuid())
  orderId    String
  category   OrderDocumentCategory
  fileName   String
  fileUrl    String
  uploadedAt DateTime              @default(now())
  order      Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, category])
}

model OrderItem {
  id                     String              @id @default(cuid())
  orderId                String
  productId              String
  nameSnapshot           String
  priceSnapshot          Int
  quantity               Int
  cancelled              Boolean             @default(false)
  status                 OrderStatus         @default(AWAITING_PAYMENT)
  statusNotifyPending    Boolean             @default(false)
  stockWrittenOff        Boolean             @default(false)
  deferred               Boolean             @default(false)
  deliveryConfirmPending Boolean             @default(false)
  deliveryDate           DateTime?
  deliveryMethod         DeliveryMethod?
  deliveryPrevMethod     DeliveryMethod?
  paid                   Boolean             @default(false)
  offerId                String?
  saleRef                String?
  surcharge              Int                 @default(0)
  bonus                  Int                 @default(0)
  claims                 Claim[]
  offer                  SupplierOffer?      @relation(fields: [offerId], references: [id])
  order                  Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product                Product             @relation(fields: [productId], references: [id])
  supplierOrderLines     SupplierOrderLine[]

  @@index([orderId])
  @@index([productId, status])
  @@index([statusNotifyPending])
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String
  status          PaymentStatus @default(PENDING)
  confirmationUrl String?
  rawPayload      Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  amount          Int
  lineIds         String[]
  operationId     String?       @unique
  paidAt          DateTime?
  receipts        CashReceipt[]
  order           Order         @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
}

model CashReceipt {
  id        String   @id @default(cuid())
  orderId   String
  paymentId String?
  kind      String
  lineIds   String[]
  amount    Int
  atolUuid  String?
  status    String   @default("new")
  error     String?
  fiscal    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id])
  payment   Payment? @relation(fields: [paymentId], references: [id])

  @@index([orderId])
  @@index([status])
}

model CashboxSettings {
  id              Int      @id @default(1)
  atolLogin       String   @default("")
  atolPasswordEnc String?
  atolGroupCode   String   @default("")
  sno             String   @default("osn")
  vat             String   @default("vat22")
  inn             String   @default("")
  email           String   @default("")
  paymentAddress  String   @default("https://emv.one")
  receiptsEnabled Boolean  @default(false)
  sbpEnabled      Boolean  @default(false)
  bankAccountId   String?
  customerCode    String?
  merchantId      String?
  updatedAt       DateTime @updatedAt
}

model User {
  id                    String            @id @default(cuid())
  lastName              String?
  firstName             String?
  patronymic            String?
  login                 String            @unique
  passwordHash          String
  email                 String?           @unique
  phone                 String?
  role                  Role
  companyId             String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  defaultDeliveryMethod DeliveryMethod?
  defaultSettlement     String?
  defaultStreet         String?
  defaultHouse          String?
  defaultApartment      String?
  defaultTerminal       String?
  mailLogin             String?
  mailPasswordEnc       String?
  emailVerifiedAt       DateTime?
  emailCodeHash         String?
  emailCodeExpiresAt    DateTime?
  emailCodeSentAt       DateTime?
  emailCodeAttempts     Int               @default(0)
  mailSenderName        String?
  mailSignature         String?
  mailPageSize          Int               @default(30)
  mailSignatureLogo     Bytes?
  mailSignatureLogoType String?
  personalDataConsentAt DateTime?
  access                Json?
  salaryPercent         Float?
  position              String?
  salary                Int?
  bonusSettlements      BonusSettlement[]
  managedCompanies      Company[]         @relation("CompanyManager")
  extraCosts            ExtraCost[]       @relation("ExtraCostEmployee")
  mailRules             MailRule[]
  mailRuleState         MailRuleState?
  managedOrders         Order[]           @relation("OrderManager")
  orders                Order[]
  PaymentRequest        PaymentRequest[]
  payrollRows           PayrollRow[]
  company               Company?          @relation("CompanyUsers", fields: [companyId], references: [id])
  invitation            UserInvitation?

  @@index([role])
  @@index([companyId])
}

model UserInvitation {
  id        String    @id @default(cuid())
  userId    String    @unique
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model MailSettings {
  id          Int      @id @default(1)
  smtpHost    String
  smtpPort    Int
  imapHost    String
  imapPort    Int
  login       String
  passwordEnc String
  senderEmail String
  senderName  String?
  updatedAt   DateTime @updatedAt
}

model OneCSettings {
  id               Int       @id @default(1)
  baseUrl          String
  login            String
  passwordEnc      String
  updatedAt        DateTime  @updatedAt
  stockSyncedAt    DateTime?
  stockSyncSummary String?
}

model YandexFleetSettings {
  id        Int      @id @default(1)
  parkId    String
  clientId  String
  apiKeyEnc String
  updatedAt DateTime @updatedAt
}

model GlonassSettings {
  id          Int      @id @default(1)
  serverUrl   String
  login       String
  passwordEnc String
  updatedAt   DateTime @updatedAt
}

model Company {
  id                          String              @id @default(cuid())
  name                        String
  inn                         String?
  ogrn                        String?
  address                     String?
  contract                    String?
  type                        String?
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  managerId                   String?
  hasContract                 Boolean             @default(false)
  paymentType                 CompanyPaymentType  @default(PREPAYMENT)
  paymentDeferralDays         Int?
  kpp                         String?
  oneCRef                     String?             @unique
  isOwn                       Boolean             @default(false)
  priceType                   CompanyPriceType    @default(WHOLESALE)
  individualMarkup            Float?
  contactEmail                String?
  contactName                 String?
  contactPhone                String?
  bonusSettlements            BonusSettlement[]
  manager                     User?               @relation("CompanyManager", fields: [managerId], references: [id])
  documents                   CompanyDocument[]
  extraCosts                  ExtraCost[]         @relation("ExtraCostSupplier")
  buyerOrders                 Order[]             @relation("OrderBuyerCompany")
  bonusCompanyPaymentRequests PaymentRequest[]    @relation("PaymentRequest_bonusCompanyIdToCompany")
  paymentRequests             PaymentRequest[]    @relation("PaymentRequestCompany")
  priceRequests               PriceRequest[]      @relation("PriceRequestSupplier")
  suppliedProducts            ProductPricing[]
  supplierOffers              SupplierOffer[]
  partnerStocks               PartnerStock[]
  supplierOrderLines          SupplierOrderLine[]
  supplierProfile             SupplierProfile?
  supplierPurchases           SupplierPurchase[]  @relation("SupplierPurchaseSupplier")
  supplierReceipts            SupplierReceipt[]   @relation("SupplierReceiptSupplier")
  users                       User[]              @relation("CompanyUsers")

  @@index([managerId])
}

model CompanyDocument {
  id         String   @id @default(cuid())
  companyId  String
  fileName   String
  fileUrl    String
  uploadedAt DateTime @default(now())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Vehicle {
  id             String            @id @default(cuid())
  brand          String
  model          String
  licensePlate   String            @unique
  vin            String            @unique
  color          String
  year           Int
  ptsNumber      String
  ptsIssueDate   DateTime
  stsNumber      String
  stsIssueDate   DateTime
  status         VehicleStatus     @default(FREE)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  leasingMonthly Int?
  fuelReceipts   FuelReceipt[]
  repairs        Repair[]
  documents      VehicleDocument[]

  @@index([status])
}

model VehicleDocument {
  id         String   @id @default(cuid())
  vehicleId  String
  fileName   String
  fileUrl    String
  uploadedAt DateTime @default(now())
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

model FuelReceipt {
  id            String   @id @default(cuid())
  date          DateTime
  driverName    String
  vehicleId     String
  fuelType      FuelType
  liters        Float
  pricePerLiter Int
  totalAmount   Int
  vatRate       Int?
  stationInn    String
  stationName   String
  fileName      String
  fileUrl       String
  createdAt     DateTime @default(now())
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])

  @@index([date])
  @@index([vehicleId])
}

model DriverApplication {
  id                       String                  @id @default(cuid())
  name                     String
  phone                    String
  drivingExperienceYears   Int?
  previousDriverExperience Boolean
  status                   DriverApplicationStatus @default(NEW)
  createdAt                DateTime                @default(now())

  @@index([status])
}

model SearchLog {
  id          String           @id @default(cuid())
  productId   String?
  brand       String
  sku         String
  name        String?
  inSystem    Boolean
  totalCount  Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  product     Product?         @relation(fields: [productId], references: [id])
  dailyCounts SearchLogDaily[]

  @@unique([brand, sku])
  @@index([productId])
  @@index([inSystem])
}

model SearchLogDaily {
  id          String    @id @default(cuid())
  searchLogId String
  date        DateTime
  count       Int       @default(0)
  searchLog   SearchLog @relation(fields: [searchLogId], references: [id], onDelete: Cascade)

  @@unique([searchLogId, date])
  @@index([searchLogId])
}

model BulkSearchRequest {
  id        String   @id @default(cuid())
  rows      Json
  createdAt DateTime @default(now())
}

model MailRule {
  id             String   @id @default(cuid())
  userId         String
  name           String
  enabled        Boolean  @default(true)
  position       Int      @default(0)
  matchAll       Boolean  @default(true)
  conditions     Json
  attachments    String   @default("any")
  moveTo         String?
  markRead       Boolean  @default(false)
  flag           Boolean  @default(false)
  remove         Boolean  @default(false)
  forwardTo      String?
  replyText      String?
  stopProcessing Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, position])
}

model MailRuleState {
  userId      String   @id
  uidValidity String
  lastUid     Int
  replied     Json     @default("{}")
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// *
///  * Почта: a letter's line in the list (from, to, subject, date, attachments)
///  * -- never changes for its uid, and Yandex is slow to give it, so it is read
///  * once (src/lib/mail/messages.ts). Flags are always asked fresh.
model MailSummary {
  userId      String
  folder      String
  uidValidity String
  uid         Int
  data        Json
  createdAt   DateTime @default(now())

  @@id([userId, folder, uidValidity, uid])
}

model RoleAccess {
  role      Role     @id
  access    Json
  updatedAt DateTime @updatedAt
}

model Repair {
  id        String           @id @default(cuid())
  date      DateTime
  vehicleId String
  type      RepairType
  shop      RepairShop
  status    RepairStatus     @default(PLANNED)
  note      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  vehicle   Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  documents RepairDocument[]
  lines     RepairLine[]

  @@index([vehicleId])
  @@index([date])
}

model RepairLine {
  id        String         @id @default(cuid())
  repairId  String
  kind      RepairLineKind
  productId String?
  serviceId String?
  name      String
  quantity  Float
  price     Int
  createdAt DateTime       @default(now())
  product   Product?       @relation(fields: [productId], references: [id])
  repair    Repair         @relation(fields: [repairId], references: [id], onDelete: Cascade)
  service   Service?       @relation(fields: [serviceId], references: [id])

  @@index([repairId])
}

model RepairDocument {
  id         String   @id @default(cuid())
  repairId   String
  fileName   String
  fileUrl    String
  uploadedAt DateTime @default(now())
  repair     Repair   @relation(fields: [repairId], references: [id], onDelete: Cascade)

  @@index([repairId])
}

/// *
///  * Проценка по почте: a supplier asked for prices of an order's lines. The
///  * reply's table becomes offers; a day without one -- a reminder; two days --
///  * the summary to the shop's mailbox (src/lib/price-requests.ts).
model PriceRequest {
  id                String             @id @default(cuid())
  orderId           String
  supplierId        String
  email             String
  contactName       String?
  items             Json
  messageId         String?
  sentAt            DateTime           @default(now())
  remindedAt        DateTime?
  answeredAt        DateTime?
  answerNote        String?
  summarySentAt     DateTime?
  answerBody        String?
  answerReviewedAt  DateTime?
  tokenHash         String?            @unique
  managerNotifiedAt DateTime?
  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplier          Company            @relation("PriceRequestSupplier", fields: [supplierId], references: [id], onDelete: Cascade)
  lines             PriceRequestLine[]

  @@unique([orderId, supplierId])
  @@index([orderId])
  @@index([supplierId])
  @@index([answeredAt])
}

model PriceRequestLine {
  requestId String
  productId String
  status    PriceRequestLineStatus @default(PENDING)
  request   PriceRequest           @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product   Product                @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([requestId, productId])
  @@index([productId])
}

/// *
///  * Возврат / рекламация of a shipped order line: the customer asks in «Мои
///  * заказы» (reason, photos), the staff decide in CRM → Рекламации; a defect
///  * goes to the supplier as a claim (src/lib/claims.ts).
model Claim {
  id              String    @id @default(cuid())
  number          Int       @unique @default(autoincrement())
  orderId         String
  orderItemId     String
  userId          String?
  quantity        Int
  reason          String
  description     String
  photos          String[]
  status          String    @default("Новая")
  resolution      String?
  answer          String?
  supplierClaimAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem       OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([orderItemId])
  @@index([status])
}

/// *
///  * A bank account of the shop (Настройки → Банки): Точка by its API, others by
///  * their statement in the 1С «Клиент-банк» format (src/lib/banks.ts).
model BankAccount {
  id            String            @id @default(cuid())
  name          String
  kind          String
  accountNumber String
  bik           String?
  tokenEnc      String?
  isActive      Boolean           @default(true)
  lastSyncAt    DateTime?
  lastSyncNote  String?
  createdAt     DateTime          @default(now())
  syncHours     String            @default("10,14,20")
  transactions  BankTransaction[]
}

/// *
///  * A payment of a statement; an incoming one is matched with an order and marks it paid.
model BankTransaction {
  id               String          @id @default(cuid())
  bankAccountId    String
  externalId       String
  date             DateTime
  incoming         Boolean
  amount           Int
  counterpartyName String?
  counterpartyInn  String?
  purpose          String?
  documentNumber   String?
  orderId          String?
  matchNote        String?
  createdAt        DateTime        @default(now())
  bankAccount      BankAccount     @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  order            Order?          @relation(fields: [orderId], references: [id])
  paymentRequest   PaymentRequest?

  @@unique([bankAccountId, externalId])
  @@index([date])
  @@index([orderId])
}

/// *
///  * Заказ поставщику: the lines of one supplier for one customer order (or
///  * without one), sent with an Excel sheet; the supplier's invoice from the
///  * reply makes them «Требуется оплата» (src/lib/supplier-purchases.ts).
model SupplierPurchase {
  id             String                 @id @default(cuid())
  number         Int                    @unique @default(autoincrement())
  supplierId     String
  orderId        String?
  email          String?
  contactName    String?
  messageId      String?
  invoiceTokenHash String?               @unique
  sentAt         DateTime?
  invoiceAt      DateTime?
  createdAt      DateTime               @default(now())
  paymentRequest PaymentRequest?
  lines          SupplierOrderLine[]
  order          Order?                 @relation(fields: [orderId], references: [id])
  supplier       Company                @relation("SupplierPurchaseSupplier", fields: [supplierId], references: [id], onDelete: Cascade)
  files          SupplierPurchaseFile[]

  @@index([supplierId])
  @@index([orderId])
}

/// *
///  * A file of a supplier order: its invoice, the payment order, others.
model SupplierPurchaseFile {
  id         String           @id @default(cuid())
  purchaseId String
  kind       String
  fileName   String
  fileUrl    String
  createdAt  DateTime         @default(now())
  purchase   SupplierPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
}

/// *
///  * Склад → Поступление: the supplier's УПД received at a warehouse -- the
///  * «Поступление» written and posted in 1С, its lines «Поставлено»
///  * (src/lib/supplier-receipts.ts).
model SupplierReceipt {
  id           String              @id @default(cuid())
  number       Int                 @unique @default(autoincrement())
  supplierId   String
  warehouseRef String
  docNumber    String
  docDate      DateTime
  vatRate      String
  amount       Int
  oneCRef      String?
  oneCNumber   String?
  fileName     String?
  fileUrl      String?
  note         String?
  createdAt    DateTime            @default(now())
  lines        SupplierOrderLine[]
  supplier     Company             @relation("SupplierReceiptSupplier", fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

/// *
///  * Финансы → Заявки на оплату: what the shop has to pay -- a supplier's
///  * invoice of a supplier order, an extra cost, or one added by hand.
///  * `amount` stays in RUB for bank reconciliation; foreign invoice amounts are
///  * kept separately in `currencyAmount`. An outgoing payment of a statement
///  * to the same ИНН for the same sum closes it
///  * (src/lib/payment-requests.ts).
model PaymentRequest {
  id                String                 @id @default(cuid())
  number            Int                    @unique @default(autoincrement())
  companyId         String?
  inn               String?
  orderId           String?
  purchaseId        String?                @unique
  extraCostId       String?                @unique
  amount            Int
  currency          String                 @default("RUB")
  currencyAmount    Int?
  exchangeRate      Float?                 @default(1)
  purpose           String?
  status            String                 @default("Требуется оплата")
  paidAt            DateTime?
  bankTransactionId String?                @unique
  createdAt         DateTime               @default(now())
  fund              String                 @default("FREE")
  purposeCategory   PaymentPurposeCategory @default(OTHER)
  managerId         String?
  bonusCompanyId    String?
  bonusPeriodFrom   DateTime?
  bonusPeriodTo     DateTime?
  bonusSettlementId String?                @unique
  bankTransaction   BankTransaction?       @relation(fields: [bankTransactionId], references: [id])
  bonusCompany      Company?               @relation("PaymentRequest_bonusCompanyIdToCompany", fields: [bonusCompanyId], references: [id])
  bonusSettlement   BonusSettlement?       @relation(fields: [bonusSettlementId], references: [id])
  company           Company?               @relation("PaymentRequestCompany", fields: [companyId], references: [id])
  extraCost         ExtraCost?             @relation(fields: [extraCostId], references: [id], onDelete: Cascade)
  manager           User?                  @relation(fields: [managerId], references: [id])
  order             Order?                 @relation(fields: [orderId], references: [id])
  purchase          SupplierPurchase?      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  files             PaymentRequestFile[]

  @@unique([managerId, bonusCompanyId, bonusPeriodFrom, bonusPeriodTo])
  @@index([status])
  @@index([companyId])
}

/// *
///  * A file of a payment request: the invoice, the payment order, others.
model PaymentRequestFile {
  id        String         @id @default(cuid())
  requestId String
  kind      String
  fileName  String
  fileUrl   String
  createdAt DateTime       @default(now())
  request   PaymentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model PayrollRow {
  id          String   @id @default(cuid())
  month       String
  userId      String
  position    String?
  calculation String
  accrued     Int
  cash        Int      @default(0)
  output      Int?
  manual      Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([month, userId])
}

/// *
///  * Supplier profile: brands and categories a supplier works with. Used to
///  * route price requests to suppliers who may not carry the exact SKU but
///  * supply the brand or category.
model SupplierProfile {
  id                     String   @id @default(dbgenerated("gen_random_uuid()"))
  companyId              String   @unique
  brands                 String   @default("")
  categories             String   @default("")
  logisticsMarkupPercent Float    @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  company                Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model TaxSettings {
  id             Int       @id @default(1)
  patentCost     Int       @default(0)
  patentFrom     DateTime?
  patentTo       DateTime?
  insuranceFixed Int       @default(5739000)
  updatedAt      DateTime  @updatedAt
}

model BonusSettlement {
  id             String          @id @default(cuid())
  managerId      String
  companyId      String
  periodFrom     DateTime
  periodTo       DateTime
  bonusOverride  Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager        User            @relation(fields: [managerId], references: [id], onDelete: Cascade)
  paymentRequest PaymentRequest?

  @@unique([managerId, companyId, periodFrom, periodTo])
  @@index([companyId, periodFrom, periodTo])
}

model SiteSettings {
  id                 Int      @id @default(1)
  manualInputEnabled Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}

